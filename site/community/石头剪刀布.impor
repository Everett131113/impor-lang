important<<DAY<<english("English"):
// 石头剪刀布（预设对局版）
var moves = ["石头", "剪刀", "布"]
var player = [0, 2, 1, 0]
var cpu = [1, 1, 2, 2]
var score = 0
var i = 0
while i < len(player)
    var p = moves[player[i]]
    var c = moves[cpu[i]]
    if player[i] == cpu[i]
        print("第", i + 1, "局：", p, "对", c, "平局")
    elseif (player[i] + 1) % 3 == cpu[i]
        print("第", i + 1, "局：", p, "对", c, "你赢")
        score = score + 1
    else
        print("第", i + 1, "局：", p, "对", c, "电脑赢")
    i = i + 1
print("总得分：", score)

// std/fs.impor — 文件读写与目录操作
// 使用：import std.fs  →  std.fs.read("a.txt")

def read(path) {
    return fileread(path)
}

def write(path, text) {
    filewrite(path, text)
    return text
}

def exists(path) {
    return fileexists(path)
}

def list(dir) {
    return filelist(dir)
}

def mkdir(dir) {
    filemkdir(dir)
}

def move(old_path, new_path) {
    filemv(old_path, new_path)
}

def size(path) {
    return filesize(path)
}

def read_json(path) {
    return json_decode(fileread(path))
}

def write_json(path, value) {
    var text = json_encode(value)
    filewrite(path, text)
    return text
}

export read
export write
export exists
export list
export mkdir
export move
export size
export read_json
export write_json

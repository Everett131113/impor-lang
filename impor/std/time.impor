// std/time.impor — 时间戳、睡眠与人可读时间
// 使用：import std.time  →  std.time.readable()

def readable() {
    return now()
}

def seconds() {
    return clock()
}

def sleep_ms(ms) {
    sleep(ms / 1000.0)
}

def elapsed(start) {
    return clock() - start
}

export readable
export seconds
export sleep_ms
export elapsed

// std/algo.impor — Impor (I++) 内置标准库：排序与查找（v3.9）
// 使用：use std.algo 或 import std.algo
// 只依赖三端共有内建（arrdup / arrappend / len / 下标），不依赖宿主方法。

def sorted(lst) {
    var out = arrdup(lst)
    var i = 1
    while i < len(out) {
        var v = out[i]
        var j = i - 1
        while j >= 0 {
            if out[j] > v {
                out[j + 1] = out[j]
                j -= 1
            } else {
                break
            }
        }
        out[j + 1] = v
        i += 1
    }
    return out
}

def sorted_desc(lst) {
    var out = arrdup(lst)
    var i = 1
    while i < len(out) {
        var v = out[i]
        var j = i - 1
        while j >= 0 {
            if out[j] < v {
                out[j + 1] = out[j]
                j -= 1
            } else {
                break
            }
        }
        out[j + 1] = v
        i += 1
    }
    return out
}

def index_of(lst, target) {
    var i = 0
    while i < len(lst) {
        if lst[i] == target {
            return i
        }
        i += 1
    }
    return - 1
}

def bsearch(lst, target) {
    var lo = 0
    var hi = len(lst) - 1
    while lo <= hi {
        var mid = div(lo + hi, 2)
        var mv = lst[mid]
        if mv == target {
            return mid
        }
        if mv < target {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return - 1
}

def min_index(lst) {
    if len(lst) == 0 {
        return - 1
    }
    var k = 0
    var i = 1
    while i < len(lst) {
        if lst[i] < lst[k] {
            k = i
        }
        i += 1
    }
    return k
}

def max_index(lst) {
    if len(lst) == 0 {
        return - 1
    }
    var k = 0
    var i = 1
    while i < len(lst) {
        if lst[i] > lst[k] {
            k = i
        }
        i += 1
    }
    return k
}

export sorted
export sorted_desc
export index_of
export bsearch
export min_index
export max_index

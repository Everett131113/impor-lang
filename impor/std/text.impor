// std/text.impor — Impor (I++) 内置标准库：文本工具
// 使用：use std.text 或 import std.text
// 提供统一、对用户友好的文本 API（隐藏宿主细节，返回类型稳定）。

def split(s, sep) {
    return s.split(sep)
}

def join(parts, sep) {
    var out = ""
    var first = true
    for p in parts {
        if not first {
            out += sep
        }
        out += p
        first = false
    }
    return out
}

def trim(s) {
    return s.strip()
}

def upper(s) {
    return s.upper()
}

def lower(s) {
    return s.lower()
}

def replace(s, old, replacement) {
    return s.replace(old, replacement)
}

def contains(s, sub) {
    return s.find(sub) >= 0
}

def starts_with(s, pre) {
    return s.startswith(pre)
}

def ends_with(s, suf) {
    return s.endswith(suf)
}

def char_at(s, i) {
    return s[i]
}

def substring(s, start, end) {
    return s[start : end]
}

def repeat(s, n) {
    var out = ""
    var i = 0
    while i < n {
        out += s
        i += 1
    }
    return out
}

// v3.9 文本扩展：填充 / 子串定位 / 行切分（不依赖宿主方法，除 trim 外均为纯内建实现）
def pad_left(s, width, ch) {
    return strpad(s, width, ch)
}

def pad_right(s, width, ch) {
    if len(s) >= width {
        return s
    }
    return s + repeat(ch, width - len(s))
}

def index_of(s, sub) {
    if len(sub) == 0 {
        return 0
    }
    var i = 0
    while i + len(sub) <= len(s) {
        if strcut(s, i, i + len(sub)) == sub {
            return i
        }
        i += 1
    }
    return - 1
}

def count_sub(s, sub) {
    if len(sub) == 0 {
        return 0
    }
    var c = 0
    var i = 0
    while i + len(sub) <= len(s) {
        if strcut(s, i, i + len(sub)) == sub {
            c += 1
            i += len(sub)
        } else {
            i += 1
        }
    }
    return c
}

def split_lines(s) {
    var out = []
    var start = 0
    var i = 0
    while i < len(s) {
        if s[i] == "\n" {
            arrappend(out, strcut(s, start, i))
            start = i + 1
        }
        i += 1
    }
    arrappend(out, strcut(s, start, len(s)))
    return out
}

def is_blank(s) {
    return trim(s) == ""
}

export split
export join
export trim
export upper
export lower
export replace
export contains
export starts_with
export ends_with
export char_at
export substring
export repeat
export pad_left
export pad_right
export index_of
export count_sub
export split_lines
export is_blank

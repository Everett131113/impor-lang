// std/text.impor — Impor (I++) 内置标准库：文本工具
// 使用：use std.text 或 import std.text
// 提供统一、对用户友好的文本 API（隐藏宿主细节，返回类型稳定）。

def split(s, sep) {
    // v4.3.2：改为纯内建实现。此前 `return s.split(sep)` 依赖宿主方法，
    // C 后端没有字符串 split 方法分派，任何 `use std.text` 的程序编 exe 都会
    // 抛 AttributeError: 字符串无此方法 [E1006]。这里只用 len / 切片 / 比较 / arrappend，
    // 解释器、Python 转译、C 后端三条路径都能跑。
    var out = []
    var n = len(s)
    var m = len(sep)
    if m == 0 {
        return out
    }
    var start = 0
    var i = 0
    while i <= n - m {
        if s[i : i + m] == sep {
            arrappend(out, s[start : i])
            set start = i + m
            set i = start
        } else {
            set i = i + 1
        }
    }
    arrappend(out, s[start : n])
    return out
}

def join(parts, sep) {
    var out = ""
    var first = true
    for p in parts {
        if not first {
            out += sep
        }
        out += p
        first = false
    }
    return out
}

def trim(s) {
    return s.strip()
}

def upper(s) {
    return s.upper()
}

def lower(s) {
    return s.lower()
}

def replace(s, old, replacement) {
    return s.replace(old, replacement)
}

def contains(s, sub) {
    return s.find(sub) >= 0
}

def starts_with(s, pre) {
    // v4.3.2：`.startswith` 是 Python 名，C 后端只认 starts_with/startswith 之外的
    // 方法名表，编 exe 会抛 E1006。改用 strcut 前缀比较，三路一致。
    if len(pre) == 0 {
        return true
    }
    if len(s) < len(pre) {
        return false
    }
    return strcut(s, 0, len(pre)) == pre
}

def ends_with(s, suf) {
    // v4.3.2：同上，避开 Python 专有的 `.endswith`。
    if len(suf) == 0 {
        return true
    }
    if len(s) < len(suf) {
        return false
    }
    return strcut(s, len(s) - len(suf), len(s)) == suf
}

def char_at(s, i) {
    return s[i]
}

def substring(s, start, end) {
    return s[start : end]
}

def repeat(s, n) {
    var out = ""
    var i = 0
    while i < n {
        out += s
        i += 1
    }
    return out
}

// v3.9 文本扩展：填充 / 子串定位 / 行切分（不依赖宿主方法，除 trim 外均为纯内建实现）
def pad_left(s, width, ch) {
    return strpad(s, width, ch)
}

def pad_right(s, width, ch) {
    if len(s) >= width {
        return s
    }
    return s + repeat(ch, width - len(s))
}

def index_of(s, sub) {
    if len(sub) == 0 {
        return 0
    }
    var i = 0
    while i + len(sub) <= len(s) {
        if strcut(s, i, i + len(sub)) == sub {
            return i
        }
        i += 1
    }
    return - 1
}

def count_sub(s, sub) {
    if len(sub) == 0 {
        return 0
    }
    var c = 0
    var i = 0
    while i + len(sub) <= len(s) {
        if strcut(s, i, i + len(sub)) == sub {
            c += 1
            i += len(sub)
        } else {
            i += 1
        }
    }
    return c
}

def split_lines(s) {
    var out = []
    var start = 0
    var i = 0
    while i < len(s) {
        if s[i] == "\n" {
            arrappend(out, strcut(s, start, i))
            start = i + 1
        }
        i += 1
    }
    arrappend(out, strcut(s, start, len(s)))
    return out
}

def is_blank(s) {
    return trim(s) == ""
}

export split
export join
export trim
export upper
export lower
export replace
export contains
export starts_with
export ends_with
export char_at
export substring
export repeat
export pad_left
export pad_right
export index_of
export count_sub
export split_lines
export is_blank

// std/path.impor — 跨平台路径拼接与拆分（解释器 / C 后端同一套实现）
// 使用：import std.path  →  std.path.join("docs", "a.md")
// 只用 strcut / len 等基础内建，不依赖宿主字符串方法。

func _last_index(s, ch) {
    var i = 0
    var found = -1
    while i < len(s) {
        if strcut(s, i, i + 1) == ch {
            found = i
        }
        i += 1
    }
    return found
}

func norm(p) {
    var s = to_str(p)
    var out = ""
    var i = 0
    while i < len(s) {
        var c = strcut(s, i, i + 1)
        if c == "\\" {
            out += "/"
        } else {
            out += c
        }
        i += 1
    }
    while len(out) > 1 and strcut(out, len(out) - 1, len(out)) == "/" {
        out = strcut(out, 0, len(out) - 1)
    }
    return out
}

func is_abs(p) {
    var s = norm(p)
    if strcut(s, 0, 1) == "/" {
        return true
    }
    if len(s) >= 2 and strcut(s, 1, 2) == ":" {
        return true
    }
    return false
}

func join(a, b) {
    var left = norm(a)
    var right = norm(b)
    if right == "" {
        return left
    }
    if is_abs(right) {
        return right
    }
    if left == "" {
        return right
    }
    return left + "/" + right
}

func basename(p) {
    var s = norm(p)
    var idx = _last_index(s, "/")
    if idx < 0 {
        return s
    }
    return strcut(s, idx + 1, len(s))
}

func dirname(p) {
    var s = norm(p)
    var idx = _last_index(s, "/")
    if idx < 0 {
        return ""
    }
    if idx == 0 {
        return "/"
    }
    return strcut(s, 0, idx)
}

func ext(p) {
    var name = basename(p)
    var idx = _last_index(name, ".")
    if idx < 0 {
        return ""
    }
    return strcut(name, idx, len(name))
}

func stem(p) {
    var name = basename(p)
    var e = ext(p)
    if e == "" {
        return name
    }
    return strcut(name, 0, len(name) - len(e))
}

export norm
export is_abs
export join
export basename
export dirname
export ext
export stem

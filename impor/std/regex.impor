// std/regex.impor — 正则封装（底层是运行时内建 regex_match/find/replace）
// 口径：语法跟随宿主（Python re 语法），三端行为以 conformance 为准。

def is_match(pattern, text) {
    return regex_match(pattern, text)
}

def find_all(pattern, text) {
    return regex_find(pattern, text)
}

def find_first(pattern, text) {
    var xs = regex_find(pattern, text)
    if len(xs) == 0 {
        return ""
    }
    return xs[0]
}

def replace_all(pattern, repl, text) {
    return regex_replace(pattern, repl, text)
}

def count(pattern, text) {
    return len(regex_find(pattern, text))
}

def contains(pattern, text) {
    return regex_match(pattern, text)
}

export is_match
export find_all
export find_first
export replace_all
export count
export contains

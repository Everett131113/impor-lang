// std/collections.impor — Impor (I++) 内置标准库：集合工具（高阶函数）
// 使用：use std.collections 或 import std.collections
// 依赖：调用方传入函数（闭包/具名函数均可）。

def map(lst, fn) {
    var out = []
    for x in lst {
        arrappend(out, fn(x))
    }
    return out
}

def filter(lst, fn) {
    var out = []
    for x in lst {
        if fn(x) {
            arrappend(out, x)
        }
    }
    return out
}

def reduce(lst, fn, init) {
    var acc = init
    for x in lst {
        acc = fn(acc, x)
    }
    return acc
}

def reverse(lst) {
    var out = []
    var i = len(lst) - 1
    while i >= 0 {
        arrappend(out, lst[i])
        i -= 1
    }
    return out
}

def contains(lst, x) {
    for v in lst {
        if v == x {
            return true
        }
    }
    return false
}

def count(lst, x) {
    var c = 0
    for v in lst {
        if v == x {
            c += 1
        }
    }
    return c
}

def uniq(lst) {
    var out = []
    for v in lst {
        if not contains(out, v) {
            arrappend(out, v)
        }
    }
    return out
}

// 空列表时返回 0（Impor 无 null 字面量）
def first(lst) {
    if len(lst) == 0 {
        return 0
    }
    return lst[0]
}

def last(lst) {
    if len(lst) == 0 {
        return 0
    }
    return lst[len(lst) - 1]
}

// v3.9 扩展：查找 / 切片（不修改原列表）
def find(lst, fn) {
    for x in lst {
        if fn(x) {
            return x
        }
    }
    return 0
}

def find_index(lst, fn) {
    var i = 0
    while i < len(lst) {
        if fn(lst[i]) {
            return i
        }
        i += 1
    }
    return - 1
}

def take(lst, n) {
    var out = []
    var i = 0
    while i < len(lst) and i < n {
        arrappend(out, lst[i])
        i += 1
    }
    return out
}

def drop(lst, n) {
    var out = []
    var i = n
    while i < len(lst) {
        arrappend(out, lst[i])
        i += 1
    }
    return out
}

// v4.1：递归拍平嵌套列表（依赖 type_of 判断元素是否为列表）
def flatten(lst) {
    var out = []
    for x in lst {
        if type_of(x) == "list" {
            for y in flatten(x) {
                arrappend(out, y)
            }
        } else {
            arrappend(out, x)
        }
    }
    return out
}

export map
export filter
export reduce
export reverse
export contains
export count
export uniq
export first
export last
export find
export find_index
export take
export drop
export flatten

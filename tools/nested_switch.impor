func f(x) {
    switch x {
        case 1:
            switch x {
                case 1:
                    return "aa"
                default:
                    return "ab"
            }
        case 2:
            return "b"
        default:
            return "z"
    }
    return "end"
}

print(f(1))
print(f(2))
print(f(3))

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Impor (I++)",
  "scopeName": "source.impor",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#header"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "header": {
      "patterns": [
        {
          "name": "meta.header.impor",
          "match": "^important<<DAY<<english\\(\"English\"\\):"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.impor",
          "match": "^\\s*##.*$"
        },
        {
          "name": "comment.line.number-sign.impor",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.impor",
          "match": "//.*$"
        },
        {
          "name": "comment.block.impor",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.impor",
          "begin": "(\"\"\"|''')",
          "end": "\\1",
          "patterns": [
            {
              "name": "constant.character.escape.impor",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.raw.impor",
          "begin": "[rR](\"|')",
          "end": "\\1",
          "patterns": []
        },
        {
          "name": "string.quoted.double.impor",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.impor",
              "match": "\\\\."
            },
            {
              "name": "string.interpolated.impor",
              "match": "\\{[^{}]*\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.impor",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.impor",
              "match": "\\\\."
            },
            {
              "name": "string.interpolated.impor",
              "match": "\\{[^{}]*\\}"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.impor",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.impor",
          "match": "\\b(if|elseif|else|while|for|in|loop|break|continue|match|case|use)\\b"
        },
        {
          "name": "keyword.declaration.impor",
          "match": "\\b(def|func|var|set|class|new|exception|export|import|from|as|nonlocal|global|interface|namespace|public|private|protected|abstract|final|override|implements|lambda|macro|template|sealed|record|defer)\\b"
        },
        {
          "name": "keyword.other.impor",
          "match": "\\b(return|true|false|and|or|not|try|catch|finally|raise|super|exit|cls)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.impor",
          "match": "\\b(print|input|inputstr|len|range|type|to_num|to_str|randi|randstr|trim|upper|lower|arrappend|arrpop|arrfind|arrfill|arrdup|arrrev|strjoin|strpad|strcut|hash|seed|wait|now|clock|open|readln|writeln|filemv|filecat|watch|snapshot|breakpoint|import_path|pause|sleep|args|vec2|rgb|clamp|lerp|remap|sign|distance|angle|shuffle|max_arr|min_arr|sum_arr|frame|fps)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.impor",
          "match": "\\|>|==|!=|>=|<=|\\+=|-=|\\*=|/=|%=|\\+|-|\\*|/|%|<|>|=|\\?|:|!"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.impor",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}

important<<DAY<<english("English"):
// 统计英文字符串里的元音
func vowels(s)
    var count = 0
    var i = 0
    loop
        if i >= len(s)
            break
        var ch = lower(strcut(s, i, i + 1))
        if ch == "a" or ch == "e" or ch == "i" or ch == "o" or ch == "u"
            set count = count + 1
        set i = i + 1
    return count

print("Impor Language 的元音数:", vowels("Impor Language"))

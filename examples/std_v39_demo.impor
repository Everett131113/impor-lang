// v3.9 标准库扩展冒烟：std.algo / std.text / std.collections
import std.algo
import std.text
import std.collections

print(std.algo.sorted([3, 1, 4, 1, 5]))
print(std.algo.sorted_desc([3, 1, 4, 1, 5]))
print(std.algo.index_of([7, 8, 9], 8))
print(std.algo.bsearch([1, 3, 5, 7, 9], 7))
print(std.algo.min_index([4, 2, 9]))
print(std.algo.max_index([4, 2, 9]))

print(std.text.pad_left("7", 3, "0"))
print(std.text.pad_right("7", 3, "-"))
print(std.text.index_of("hello", "ll"))
print(std.text.count_sub("abababa", "aba"))
print(std.text.split_lines("a\nb\nc"))

func is_big(x) {
    return x > 3
}
print(std.collections.find([1, 5, 2], is_big))
print(std.collections.find_index([1, 5, 2], is_big))
print(std.collections.take([1, 2, 3, 4], 2))
print(std.collections.drop([1, 2, 3, 4], 2))

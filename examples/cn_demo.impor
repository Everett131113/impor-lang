important<<DAY<<english("English"):
// v2.9 差异化特性演示：中文关键字 + 字符串插值 + 管道 + 隐式返回
// 运行：python Impor.py run examples/cn_demo.impor

函数 翻倍(x)
    x * 2 // 隐式返回：末行表达式自动返回

函数 求总和(列表)
    列表 |> sum_arr // 管道：列表 |> sum_arr == sum_arr(列表)

变量 成绩 = [88, 92, 76, 85]
变量 姓名 = "小明"

print("成绩总和 = {求总和(成绩)}") // 字符串插值
print("翻倍 21 = {翻倍(21)}")
print("管道链: 5 |> 翻倍 |> 翻倍 = {5 |> 翻倍 |> 翻倍}")

如果 求总和(成绩) >= 300
    print(姓名, "：优秀！总分达到 300 以上")
否则
    print(姓名, "：还需努力")

断言 求总和(成绩) == 341
print("全部通过 ✓")

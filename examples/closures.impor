important<<DAY<<english("English"):
// closures.impor — 闭包、nonlocal、global 作用域
// 运行：impor run closures.impor

// 计数器闭包
func make_counter(start)
    def inc()
        nonlocal set start = start + 1
        return start
    return inc

var c1 = make_counter(0)
var c2 = make_counter(100)
print("c1:", c1(), c1(), c1())
print("c2:", c2())

// global 修改全局变量
var total = 0
func add_to_total(n)
    global set total = total + n

add_to_total(5)
add_to_total(10)
print("total =", total)

// 高阶函数：函数作为参数
func apply_twice(f, x)
    return f(f(x))

func plus_one(x)
    return x + 1

print("apply_twice(plus_one, 3) =", apply_twice(plus_one, 3))

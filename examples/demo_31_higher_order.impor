// 高阶函数：自己实现 map 与 filter
def map(arr, f)
    var out = []
    for x in arr
        arrappend(out, f(x))
    return out

def keep(arr, pred)
    var out = []
    for x in arr
        if pred(x)
            arrappend(out, x)
    return out

def double(x)
    return x * 2

def is_even(x)
    return x % 2 == 0

var nums = [1, 2, 3, 4, 5]
print("翻倍:", map(nums, double))
print("偶数:", keep(nums, is_even))

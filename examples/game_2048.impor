important<<DAY<<english("English"):
# 2048 核心逻辑演示（v2.17）
# 纯计算、无图形库；可在 C 后端编译成独立 exe 运行：
#   impor build examples/game_2048.impor -o game2048.exe
# 自动随机走 24 步，打印每一步棋盘与得分。

var 得分 = 0

def 取空位(b, n)
    # 返回第 n 个空格下标；无空格返回 -1
    var k = 0
    while k < 16
        if b[k] == 0
            n = n - 1
            if n < 0
                return k
        k = k + 1
    return - 1

def 生成(b)
    # 随机空格放 2（90%）或 4（10%）
    var 空数 = 0
    var k = 0
    while k < 16
        if b[k] == 0
            空数 = 空数 + 1
        k = k + 1
    if 空数 == 0
        return
    var p = randi(0, 空数 - 1)
    var idx = 取空位(b, p)
    if randi(1, 100) <= 90
        b[idx] = 2
    else
        b[idx] = 4

def 合并行(b, r)
    # 就地合并第 r 行（4 格）：左移 + 相邻相同合并
    var t = [0, 0, 0, 0]
    var w = 0
    var k = 0
    while k < 4
        var v = b[r * 4 + k]
        if v != 0
            if w > 0 and t[w - 1] == v
                t[w - 1] = v * 2
                set 得分 = 得分 + v * 2
            else
                t[w] = v
                w = w + 1
        k = k + 1
    k = 0
    while k < 4
        b[r * 4 + k] = t[k]
        k = k + 1

def 移动(b, d)
    # d: 0=左 1=右 2=上 3=下（上/下按列处理，先转成行）
    var nb = arrdup(b)
    if d == 0
        var r = 0
        while r < 4
            合并行(nb, r)
            r = r + 1
    else if d == 1
        var r2 = 0
        while r2 < 4
            # 右移 = 反转行 → 左移 → 反转
            var row = arrfill(0, 0)
            var k3 = 0
            while k3 < 4
                row = arrappend(row, nb[r2 * 4 + k3])
                k3 = k3 + 1
            var rev = arrrev(row)
            合并行(rev, 0)
            var rev2 = arrrev(rev)
            var k4 = 0
            while k4 < 4
                nb[r2 * 4 + k4] = rev2[k4]
                k4 = k4 + 1
            r2 = r2 + 1
    else
        var c = 0
        while c < 4
            # 上移 = 取列 → 左移 → 写回列；下移 = 反转列 → 左移 → 反转
            var col = arrfill(0, 0)
            var k5 = 0
            while k5 < 4
                col = arrappend(col, nb[k5 * 4 + c])
                k5 = k5 + 1
            if d == 3
                col = arrrev(col)
            合并行(col, 0)
            if d == 3
                col = arrrev(col)
            var k6 = 0
            while k6 < 4
                nb[k6 * 4 + c] = col[k6]
                k6 = k6 + 1
            c = c + 1
    return nb

def 有变化(a, b)
    var k = 0
    while k < 16
        if a[k] != b[k]
            return true
        k = k + 1
    return false

def 还能动(b)
    var k = 0
    while k < 16
        if b[k] == 0
            return true
        k = k + 1
    k = 0
    while k < 16
        var r = div(k, 4)
        var c = k - r * 4
        if c < 3 and b[k] == b[k + 1]
            return true
        if r < 3 and b[k] == b[k + 4]
            return true
        k = k + 1
    return false

def 打印棋盘(b)
    var r = 0
    while r < 4
        var line = ""
        var c = 0
        while c < 4
            var v = b[r * 4 + c]
            var s = to_str(v)
            if v == 0
                s = "."
            while len(s) < 5
                s = " " + s
            line = line + s
            c = c + 1
        print(line)
        r = r + 1
    print("-------- 得分:", 得分)

var 棋盘 = arrfill(16, 0)
生成(棋盘)
生成(棋盘)
print("== 2048 自动演示（24 步随机策略）==")
打印棋盘(棋盘)
var 步 = 0
while 步 < 24
    var 新棋盘 = 移动(棋盘, randi(0, 3))
    if 有变化(棋盘, 新棋盘)
        棋盘 = 新棋盘
        生成(棋盘)
        步 = 步 + 1
        print("== 第", 步, "步 ==")
        打印棋盘(棋盘)
    if 还能动(棋盘) == false
        print("游戏结束！")
        步 = 24
var 最高 = max_arr(棋盘)
print("最终最高方块:", 最高)
if 最高 >= 2048
    print("达成 2048！")
else
    print("继续加油，目标 2048")

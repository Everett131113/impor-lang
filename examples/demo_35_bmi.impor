important<<DAY<<english("English"):
// BMI 计算与区间判断
def bmi(weight, height)
    return weight /(height * height)

def level(value)
    if value < 18.5
        return "偏瘦"
    elif value < 24
        return "正常"
    elif value < 28
        return "偏胖"
    else
        return "肥胖"

var value = bmi(65, 1.75)
print("BMI:", value)
print("区间:", level(value))

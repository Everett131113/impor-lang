// CI 用最小 C ABI 库：四个导出函数，跨 Windows MSVC / Linux GCC 验证 x64。

export def add(a : int, b : int) -> int {
    return a + b
}

export def sub(a : int, b : int) -> int {
    return a - b
}

export def mul(a : int, b : int) -> int {
    return a * b
}

export def greet(name : str) -> str {
    return "Hello, " + name
}

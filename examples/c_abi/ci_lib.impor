// CI 用最小 C ABI 库：四个导出函数，跨 Windows MSVC / Linux GCC 验证 x64。

export func add(a: int, b: int) -> int {
    return a + b
}

export func sub(a: int, b: int) -> int {
    return a - b
}

export func mul(a: int, b: int) -> int {
    return a * b
}

export func greet(name: str) -> str {
    return "Hello, " + name
}

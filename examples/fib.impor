// fib.impor — 经典递归：斐波那契数列
// 运行：impor run fib.impor

def fib(n)
    if n < 2
        return n
    return fib(n - 1) + fib(n - 2)

for i in range(0, 12)
    print("fib(", i, ") =", fib(i))

// 用数组缓存加速（动态规划版）
def fib_fast(n)
    var dp = arrfill(n + 1, 0)
    if n >= 1
        dp[1] = 1
    for i in range(2, n + 1)
        dp[i] = dp[i - 1] + dp[i - 2]
    return dp[n]

print("fib_fast(30) =", fib_fast(30))

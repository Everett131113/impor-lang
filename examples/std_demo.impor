// v2.12 标准库冒烟：use 三种标准库 + 高阶函数 + import 形式
use std.text
use std.mathx
use std.collections

print(split("a,b,c", ","))
print(join(["x", "y", "z"], "-"))
print(upper("hello"))
print(lower("WORLD"))
print(contains("hello impor", "impor"))
print(starts_with("hello", "he"))
print(ends_with("hello", "lo"))
print(repeat("ab", 3))
print(substring("hello", 1, 4))

print(gcd(48, 36))
print(lcm(4, 6))
print(fact(5))
print(fib(10))
print(is_prime(17))
print(sum([1, 2, 3, 4]))
print(avg([2, 4, 6]))
print(min_of([3, 1, 4, 1, 5]))
print(max_of([3, 1, 4, 1, 5]))

def double(x) {
    return x * 2
}
def is_even(x) {
    return x % 2 == 0
}
def add_all(a, b) {
    return a + b
}
print(map([1, 2, 3], double))
print(filter([1, 2, 3, 4, 5], is_even))
print(reduce([1, 2, 3, 4], add_all, 0))
print(reverse([1, 2, 3]))
print(contains([1, 2, 3], 2))
print(count([1, 2, 2, 3], 2))
print(uniq([1, 1, 2, 3, 3]))
print(first([7, 8, 9]))
print(last([7, 8, 9]))

// import 形式访问命名空间
import std.text
print(std.text.trim("  pad  "))

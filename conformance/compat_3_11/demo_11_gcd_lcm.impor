important<<DAY<<english("English"):
// 辗转相除求最大公约数，再求最小公倍数
func gcd(a, b)
    loop
        if b == 0
            break
        var t = b
        set b = a % b
        set a = t
    return a

func lcm(a, b)
    return div(a * b, gcd(a, b))

print("gcd(48, 36) =", gcd(48, 36))
print("lcm(4, 6) =", lcm(4, 6))

important<<DAY<<english("English"):
// 冒泡排序
var data = [5, 2, 9, 1, 3, 7]
print("排序前:", data)
var n = len(data)
for i in range(0, n)
    for j in range(0, n - 1 - i)
        if data[j] > data[j + 1]
            var t = data[j]
            data[j] = data[j + 1]
            data[j + 1] = t
print("排序后:", data)

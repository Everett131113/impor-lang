// 二分查找（数组必须有序）
func bsearch(a, target)
    var low = 0
    var high = len(a) - 1
    loop
        if low > high
            break
        var mid = div(low + high, 2)
        if a[mid] == target
            return mid
        if a[mid] < target
            set low = mid + 1
        else
            set high = mid - 1
    return -1

var sorted = [1, 3, 5, 7, 9, 11]
print("查找 7，下标 =", bsearch(sorted, 7))
print("查找 8，下标 =", bsearch(sorted, 8))

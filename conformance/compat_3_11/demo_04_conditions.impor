important<<DAY<<english("English"):
// 条件分支：成绩评级
def grade(score)
    if score >= 90
        return "A"
    elseif score >= 80
        return "B"
    elseif score >= 70
        return "C"
    elseif score >= 60
        return "D"
    else
        return "F"

var scores = [95, 83, 71, 60, 42]
for s in scores
    print("成绩", s, "评级", grade(s))
